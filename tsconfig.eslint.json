{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "eslint.config.js",
    "vitest.config.ts",
    "scripts/**/*.mjs",
    "packages/cli/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/mcp-server/src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/coverage/**",
    "packages/docs-site/**"
  ]
}
