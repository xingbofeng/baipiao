    "id": "supabase",
    "name": "Supabase",
    "slug": "supabase",
    "category": "database",
    "capability": [
      "prompt",
      "config",
      "test"
    ],
    "description": "Hosted Postgres, Auth, Storage, and edge platform.",
    "url": "https://supabase.com",
    "tags": [
      "database",
      "baas",
      "auth"
    ],
    "config": {
      "urls": {
        "homepage": "https://supabase.com",
        "console": "https://supabase.com/dashboard",
        "docs": "https://supabase.com/docs"
      },
      "freeTier": {
        "status": "free_tier",
        "summary": "Free project tier available.",
        "requiresCreditCard": false,
        "confidence": "medium"
      },
      "env": [
        {
          "key": "SUPABASE_URL",
          "secret": false,
          "required": true,
          "pattern": "^https://[a-zA-Z0-9-]+\\.supabase\\.co$",
          "description": "Supabase project URL.",
          "public": true
        },
        {
          "key": "SUPABASE_ANON_KEY",
          "secret": true,
          "required": true,
          "pattern": "^eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "description": "Supabase anon key.",
          "public": true
        },
        {
          "key": "SUPABASE_SERVICE_ROLE_KEY",
          "secret": true,
          "required": false,
          "pattern": "^eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "description": "Supabase service role key. Never expose to frontend code.",
          "public": false
        }
      ],
      "prompt": {
        "setupUrl": "https://supabase.com/dashboard/projects",
        "projectNamePattern": "baipiao-${project_slug}",
        "steps": [
          "Open https://supabase.com/dashboard/projects.",
          "Create or select a project named baipiao-${project_slug}.",
          "Go to Project Settings > API.",
          "Copy the project URL, anon key, and service role key if needed."
        ],
        "safety": [
          "Never expose SUPABASE_SERVICE_ROLE_KEY to frontend code."
        ],
        "outputFormat": [
          "SUPABASE_URL=...",
          "SUPABASE_ANON_KEY=...",
          "SUPABASE_SERVICE_ROLE_KEY=..."
        ]
      },
      "test": {
        "type": "supabase",
        "urlEnvKey": "SUPABASE_URL",
        "anonKeyEnvKey": "SUPABASE_ANON_KEY"
      },
      "risks": [
        "SUPABASE_SERVICE_ROLE_KEY is server-only."
      ]
    }
